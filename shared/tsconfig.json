{
    "include": [
        "./fest/**/*.ts",
        "./test/**/*.ts",
        "../src/shared/**/*.ts"
    ],
    "exclude": [
        "node_modules/**",
        "dist/**",
        "build/**",
        "coverage/**",
        "logs/**",
        "cache/**",
        "temp/**",
        "tmp/**",
        "src/**/*.js",
        "src/**/*.jsx"
    ],
    "compilerOptions": {
        "rootDir": "..",
        "outDir": "./dist/",
        "paths": {
            "@phosphor-icons/core/assets/*": [
                "../node_modules/@phosphor-icons/core/assets/*"
            ],
            "shared/*": [
                "../src/shared/*"
            ],
            "shells/types": [
                "../src/frontend/shells/types.ts"
            ],
            "shells/boot": [
                "../src/frontend/boot/index.ts"
            ],
            "shells/window": [
                "../src/frontend/ai-slop/window/index.ts"
            ],
            "views/*": [
                "../src/frontend/views/*"
            ],
            "fonts/*": [
                "./assets/fonts/*"
            ],
            "@fest-lib/*": [
                "./fest/*"
            ],
            "@fest-lib/cdnImport": [
                "./fest/cdnImport.mjs"
            ],
            "@fest-lib/core": [
                "./fest/core/index.ts"
            ],
            "@fest-lib/dom": [
                "./fest/dom/index.ts"
            ],
            "@fest-lib/style-lib": [
                "./fest/style-lib/index.ts"
            ],
            "@fest-lib/fl-ui": [
                "./fest/fl-ui/index.ts"
            ],
            "@fest-lib/lure": [
                "./fest/lure/index.ts"
            ],
            "@fest-lib/object": [
                "./fest/object/index.ts"
            ],
            "@fest-lib/uniform": [
                "./fest/uniform/index.ts"
            ],
            "@fest-lib/theme": [
                "./fest/theme/index.ts"
            ],
            "@fest-lib/icon": [
                "./fest/icon/index.ts"
            ],
            "@fest-lib/polyfill/*": [
                "./fest/polyfill/*"
            ],
            "polyfill/*": [
                "./fest/polyfill/*"
            ],
            "pwa/*": [
                "../src/pwa/*"
            ],
            "com/*": [
                "../src/com/*"
            ],
            "core/*": [
                "../src/shared/*",
                "../src/core/*"
            ],
            "crx/*": [
                "../../CWSP-crx/src/crx/*"
            ],
            "frontend/*": [
                "../src/frontend/*"
            ],
            "shared/*": [
                "./*"
            ],
            "test/*": [
                "./test/*"
            ]
        },
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "preserveSymlinks": true,
        "lib": [
            "ESNext",
            "DOM",
            "WebWorker"
        ],
        "types": [
            "chrome"
        ],
        "esModuleInterop": true,
        "strict": false,
        "forceConsistentCasingInFileNames": true,
        "allowJs": true,
        "allowArbitraryExtensions": true,
        "rewriteRelativeImportExtensions": true,
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "resolveJsonModule": true,
        "allowSyntheticDefaultImports": true,
        "allowUmdGlobalAccess": true,
        "allowUnreachableCode": true,
        "allowUnusedLabels": true,
        "noImplicitAny": false,
        "noImplicitThis": false,
        "inlineSources": true,
        "inlineSourceMap": true,
        "sourceMap": false,
        "experimentalDecorators": true,
        "isolatedModules": true,
        "emitDecoratorMetadata": false,
        "useDefineForClassFields": false,
        "noEmit": true,
        "noEmitOnError": true,
        "noEmitHelpers": true
    },
    "compileOnSave": false
}
