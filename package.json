{
    "name": "cwsp-shell",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "build": "npm run build:pwa",
        "build:pwa": "rm -rf ./dist && node ./scripts/run-vite.mjs build && node ./scripts/normalize-worker-names.mjs",
        "postbuild:pwa": "node ./scripts/copy-pwa-to-endpoint.mjs",
        "build:cw-markdown": "rm -rf ./build/cw-markdown && node ./scripts/run-vite.mjs build --config vite.config.js --mode markdown && node ./scripts/normalize-worker-names.mjs --dir build/cw-markdown && node ./scripts/stage-cw-markdown.mjs",
        "build:vds-main": "rm -rf ./build/vds-main && node ./scripts/run-vite.mjs build --config vite.config.js --mode vds-main && node ./scripts/normalize-worker-names.mjs --dir build/vds-main && node ./scripts/stage-vds-main.mjs",
        "stage:vds-main": "node ./scripts/stage-vds-main.mjs",
        "stage:fest-libs": "node ../../modules/projects/scripts/stage-fest-libs.mjs",
        "build:all": "node ./scripts/build.mjs pwa",
        "stage:cw-markdown": "node ./scripts/stage-cw-markdown.mjs",
        "build:modules": "node ./scripts/build.mjs modules",
        "preview": "node ./scripts/run-vite.mjs preview",
        "start": "npm run dev",
        "dev": "VITE_MCP_DISABLE=1 node ./scripts/run-vite.mjs dev",
        "dev:8434": "VITE_MCP_DISABLE=1 VITE_DEV_PORT=8434 node ./scripts/run-vite.mjs dev",
        "dev:clean": "rm -rf node_modules/.vite && npm run dev",
        "dev:full": "node ./scripts/run-vite.mjs dev",
        "dev:no-sw": "VITE_MCP_DISABLE=1 VITE_PWA_DEV_DISABLE=1 node ./scripts/run-vite.mjs dev",
        "dev:lite": "npm run dev",
        "test": "npm run dev",
        "test:dev": "npm run dev",
        "test:test": "echo 'No tests configured for cwsp-shell' && exit 0",
        "test:explorer": "npx --yes tsx --test ./src/frontend/views/explorer/inject.test.ts",
        "sync:cw-markdown": "node ./scripts/stage-cw-markdown.mjs",
        "build:capacitor:web": "rm -rf ./build/capacitor/web && node ./scripts/run-vite.mjs build --config vite.config.js --mode capacitor-launcher",
        "build:capacitor": "node ./scripts/build-capacitor.mjs",
        "build:capacitor:launcher": "node ./scripts/build-capacitor.mjs --no-bump",
        "build:capacitor:apk": "node ./scripts/build-capacitor.mjs",
        "build:capacitor:apk:release": "node ./scripts/build-capacitor.mjs --release",
        "build:capacitor:install": "npm run build:capacitor:launcher && node ./scripts/install-capacitor-apk.mjs",
        "install:capacitor:apk": "node ./scripts/install-capacitor-apk.mjs",
        "bump:capacitor:version": "node ./scripts/bump-capacitor-version.mjs",
        "sync:capacitor:android": "node ./scripts/sync-capacitor-android.mjs",
        "sync:capacitor:identity": "node ./scripts/sync-capacitor-app-identity.mjs",
        "sync:capacitor:icons": "node ./scripts/sync-capacitor-android-icons.mjs",
        "sync:sku:icon": "node ./scripts/sync-sku-android-icon.mjs",
        "publish:apk": "node ./scripts/publish-android-apk.mjs",
        "publish:apk:200": "node ./scripts/publish-android-apk.mjs --remote",
        "build:crx": "npm --prefix ../CWSP-crx run build:crx"
    },
    "browserslist": [
        "last 1 chrome version",
        "last 1 edge version"
    ],
    "devDependencies": {
        "@cap-js-community/websocket": "^1.11.1",
        "@capacitor/android": "^8.5.1",
        "@capacitor/clipboard": "^8.0.1",
        "@capacitor/core": "^8.5.1",
        "@jsquash/jpeg": ">=1.6.0",
        "@jsquash/png": ">=3.1.1",
        "@phosphor-icons/core": ">=2.1.1",
        "@rolldown/binding-linux-x64-gnu": "1.2.7",
        "@toon-format/toon": ">=4.1.1",
        "@types/sanitize-html": ">=2.16.1",
        "autoprefixer": ">=10.5.5",
        "baseline-browser-mapping": ">=2.11.21",
        "capacitor-native-settings": "^8.2.0",
        "country-flag-emoji-polyfill": ">=0.1.10",
        "cssnano": ">=9.0.3",
        "cssnano-preset-advanced": "^9.0.3",
        "culori": ">=4.0.2",
        "docx": ">=9.7.1",
        "dompurify": ">=3.4.14",
        "esbuild": ">=0.28.2",
        "fflate": "^0.8.3",
        "isomorphic-dompurify": ">=4.1.0",
        "jsdom": ">=30.0.1",
        "jsox": ">=1.2.128",
        "lightningcss-linux-x64-gnu": "^1.33.0",
        "marked": ">=18.0.11",
        "marked-katex-extension": ">=5.1.12",
        "mathml-to-latex": ">=1.8.0",
        "pako": "^3.0.1",
        "postcss-discard-duplicates": ">=9.0.2",
        "postcss-import": ">=17.0.0",
        "postcss-preset-env": ">=11.5.1",
        "postcss-remove-duplicate-values": ">=2.0.0",
        "prettier": ">=3.9.6",
        "quill": "^2.0.3",
        "sass": ">=1.104.0",
        "tar": "^7.5.22",
        "temml": ">=0.13.5",
        "turndown": ">=7.2.4",
        "typescript": "^6.0.3",
        "vite": "^8.2.2",
        "vite-bundle-analyzer": ">=1.3.9",
        "vite-plugin-bundle-prefetch": ">=0.0.4",
        "vite-plugin-compression2": "^2.5.3",
        "vite-plugin-external": ">=8.0.3",
        "vite-plugin-jspm": ">=0.6.3",
        "vite-plugin-mcp": "^0.3.2",
        "vite-plugin-optimizer": ">=1.4.3",
        "vite-plugin-pwa": "^1.3.0",
        "vite-plugin-singlefile": ">=2.3.3",
        "vite-plugin-static-copy": ">=4.1.1",
        "vite-tsconfig-paths": ">=6.1.1"
    },
    "version": "0.0.135"
}
