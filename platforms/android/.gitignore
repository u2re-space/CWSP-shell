!capacitor-cordova-android-plugins/src/main/java/.gitkeep
capacitor-cordova-android-plugins/src/main/res/*
!capacitor-cordova-android-plugins/src/main/res/.gitkeep

# IDE
.idea/
*.iml
.DS_Store

!.gitignore
